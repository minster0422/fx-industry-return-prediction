.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.idea/
.vscode/

# The original market dataset is intentionally local-only until its
# redistribution terms and source lineage are documented.
data/raw/*
!data/raw/.gitkeep

# API payloads, private lookup tables, and runtime request logs stay local.
data/feasibility_raw/
data/metadata/private/
data/metadata/api_logs/

# Credentials are read from environment variables only.
.env
.env.*
!.env.example

# Temporary runs can be regenerated with the CLI.
results/generated/
